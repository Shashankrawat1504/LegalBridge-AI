{
  "expo": {
    "name": "LegalBridge-AI",
    "slug": "legalbridge-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "legalbridgeai",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0047AB"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.legalbridgeai.app",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "LegalBridge-AI requires microphone access to dictate FIR narratives and record complainant statements in English and Hindi for official legal documentation.",
        "NSSpeechRecognitionUsageDescription": "LegalBridge-AI uses on-device speech recognition to accurately transcribe bilingual statutory statements for First Information Reports under Section 173 BNSS."
      }
    },
    "android": {
      "package": "com.legalbridgeai.app",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "9189eb67-17e5-455c-b6fa-d4d3ae67a815"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
